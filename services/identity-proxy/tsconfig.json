{
  // Standalone config — namjerno NE nasljeđuje monorepo tsconfig.base.json:
  // worker se ne builda kroz yarn workspaces/turbo, deploya ga wrangler (esbuild).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
