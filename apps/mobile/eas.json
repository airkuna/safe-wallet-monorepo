{
  "cli": {
    "version": ">= 13.4.2",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.14.0",
      "android": {
        "image": "sdk-55"
      },
      "ios": {
        "image": "sdk-55"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "channel": "development",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "image": "sdk-55"
      }
    },
    "preview-ios-simulator": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal",
      "ios": {},
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "env": {
          "GOOGLE_SERVICES_FILE": "./GoogleService-Info.plist"
        }
      },
      "android": {
        "env": {
          "GOOGLE_SERVICES_FILE": "./google-services.json"
        }
      },
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "preview-airkuna": {
      "extends": "preview",
      "env": {
        "BRAND_ID": "airkuna"
      }
    },
    "production-airkuna": {
      "extends": "production",
      "env": {
        "BRAND_ID": "airkuna"
      }
    },
    "build-and-maestro-test": {
      "extends": "base",
      "withoutCredentials": true,
      "environment": "development",
      "env": {
        "RN_SRC_EXT": "e2e.ts,e2e.tsx",
        "EXPO_PUBLIC_SECURITY_RASP_ENABLED": "false"
      },
      "config": "build-and-maestro-test.yml",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true,
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "development": {
      "ios": {
        "ascAppId": "6748754891"
      },
      "android": {
        "applicationId": "global.safe.mobileapp.dev",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6748754793"
      },
      "android": {
        "releaseStatus": "draft"
      }
    },
    "production-airkuna": {
      "android": {
        "applicationId": "com.airkuna.wallet",
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./keys/airkuna/play-service-account.json"
      }
    }
  }
}
